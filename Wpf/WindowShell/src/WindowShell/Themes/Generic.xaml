<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chrome="clr-namespace:WindowShell.Chrome">

    <chrome:NullToVisibilityConverter x:Key="NullToVis"/>

    <!-- 标题栏按钮：46x40 热区，与系统标题栏按钮尺寸一致 -->
    <Style x:Key="ChromeCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="#AEB8C2"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <!-- HTMAXBUTTON 区域收不到 WPF 的 IsMouseOver，由 ChromeWindow 置 Tag="hover" 补上 -->
                        <Trigger Property="Tag" Value="hover">
                            <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#12FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChromeCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource ChromeCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#C42B1C"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="b" Property="Background" Value="#9E2317"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 窗口壳本体：WPF 会按 DefaultStyleKey 自动取到这份隐式样式 -->
    <Style TargetType="{x:Type chrome:ChromeWindow}">
        <Setter Property="Background" Value="#121519"/>
        <Setter Property="Foreground" Value="#E7E9EC"/>
        <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type chrome:ChromeWindow}">
                    <Border x:Name="PART_RootBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding WindowBorderBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 标题栏：整条都是 CaptionArea，拖动/双击最大化由 WindowChrome 负责 -->
                            <Grid Grid.Row="0" Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}"
                                  Background="{TemplateBinding TitleBarBackground}">

                                <!-- 默认标题（图标 + 标题） -->
                                <StackPanel x:Name="DefaultHeader" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="14,0,0,0"
                                            Visibility="{Binding HeaderContent, RelativeSource={RelativeSource TemplatedParent},
                                                                 Converter={StaticResource NullToVis}, ConverterParameter=invert}">
                                    <Image x:Name="TitleIcon" Source="{TemplateBinding Icon}" Width="18" Height="18"
                                           Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock Text="{TemplateBinding Title}" VerticalAlignment="Center"
                                               Foreground="{TemplateBinding TitleBarForeground}" FontSize="12.5"/>
                                </StackPanel>

                                <!-- 自定义标题内容 -->
                                <ContentPresenter x:Name="HeaderSlot" VerticalAlignment="Center" Margin="14,0,0,0"
                                                  Content="{TemplateBinding HeaderContent}"
                                                  Visibility="{Binding HeaderContent, RelativeSource={RelativeSource TemplatedParent},
                                                                       Converter={StaticResource NullToVis}}"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button x:Name="PART_MinButton" Style="{StaticResource ChromeCaptionButton}"
                                            ToolTip="最小化">
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                    <Button x:Name="PART_MaxButton" Style="{StaticResource ChromeCaptionButton}"
                                            ToolTip="最大化">
                                        <TextBlock x:Name="PART_MaxGlyph" Text="&#xE922;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                    <Button x:Name="PART_CloseButton" Style="{StaticResource ChromeCaptionCloseButton}"
                                            ToolTip="关闭">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <ContentPresenter Grid.Row="1" Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="PART_RootBorder" Property="BorderThickness" Value="0"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}" Value="{x:Null}">
                            <Setter TargetName="TitleIcon" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
