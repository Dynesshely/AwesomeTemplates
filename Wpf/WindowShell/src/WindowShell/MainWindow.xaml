<chrome:ChromeWindow x:Class="WindowShell.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:chrome="clr-namespace:WindowShell.Chrome"
                      Title="WindowShell · WPF 窗口壳模板"
                      Height="760" Width="1120" MinWidth="820" MinHeight="560"
                      WindowStartupLocation="CenterScreen"
                      Background="{StaticResource Bg}"
                      Icon="pack://application:,,,/assets/app.ico">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航（只是演示内容，与窗口壳无关） -->
        <Border Grid.Column="0" Background="#66101317" BorderBrush="#1AFFFFFF" BorderThickness="0,1,1,0">
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="WINDOW SHELL" FontSize="11" Foreground="#79828C" Margin="20,0,0,12"/>
                <Border Background="#18FFFFFF" Padding="20,11" BorderBrush="{StaticResource Accent}" BorderThickness="3,0,0,0">
                    <TextBlock Text="概览" Foreground="{StaticResource Fg}" FontSize="13"/>
                </Border>
                <Border Padding="20,11" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                    <TextBlock Text="标题栏" Foreground="{StaticResource Muted}" FontSize="13"/>
                </Border>
                <Border Padding="20,11" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                    <TextBlock Text="Snap Layouts" Foreground="{StaticResource Muted}" FontSize="13"/>
                </Border>
                <Border Padding="20,11" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                    <TextBlock Text="DWM 集成" Foreground="{StaticResource Muted}" FontSize="13"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- 右侧内容 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="28,22,28,28">
            <StackPanel>
                <TextBlock Text="WPF 窗口壳" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
                <TextBlock Text="自绘标题栏 + 系统原生最小化/最大化/还原动画 + Win11 Snap Layouts"
                           Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,6,0,22"/>

                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="已实现" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Text="· 标题栏完全自绘，最大化/最小化/关闭键样式在 Themes/Generic.xaml 里改&#10;· 三个键都走 SystemCommands，动画由 DWM 播放，不是自己算的&#10;· 悬停最大化键会弹出 Win11 快速布局面板（Snap Layouts）&#10;· 最大化只铺满工作区，不会盖住任务栏&#10;· 深色标题栏：DWM 属性 19/20 + 标题栏色 35/36/34"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="怎么用" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
                        <TextBlock Margin="0,10,0,0" Foreground="{StaticResource Muted}" FontSize="12.5"
                                   TextWrapping="Wrap" FontFamily="Consolas"
                                   Text="1. 拷贝 Chrome/ 与 Themes/ 到你的工程&#10;2. 把 &lt;Window&gt; 换成 &lt;chrome:ChromeWindow&gt;&#10;3. 标题栏图标/文字直接用 Window 的 Icon 与 Title&#10;4. 要自定义标题栏内容就设 HeaderContent"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource Card}" CornerRadius="10" Padding="18,16">
                    <StackPanel>
                        <TextBlock Text="试试这些" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Button Style="{StaticResource DemoButton}" Content="最大化 / 还原" Click="ToggleMax_Click"/>
                            <Button Style="{StaticResource DemoButton}" Content="切换自定义标题栏" Click="ToggleHeader_Click"/>
                            <Button Style="{StaticResource DemoButton}" Content="关于" Click="About_Click"/>
                        </WrapPanel>
                        <TextBlock x:Name="Hint" Text="提示：拖动标题栏可移动窗口；双击标题栏最大化；拖动窗口边缘改尺寸。"
                                   Foreground="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</chrome:ChromeWindow>
